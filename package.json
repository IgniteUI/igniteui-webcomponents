{
  "name": "igniteui-webcomponents",
  "version": "0.0.0",
  "description": "Ignite UI Web Components",
  "author": "Infragistics",
  "license": "MIT",
  "exports": {
    ".": "./src/index.js",
    "./types": "./src/types.js",
    "./extras": "./src/extras/index.js"
  },
  "imports": {
    "#internals/*.js": "./src/internals/*.ts",
    "#internals/*": "./src/internals/*",
    "#theming/*.js": "./src/theming/*.ts",
    "#theming/*": "./src/theming/*",
    "#animations/*.js": "./src/animations/*.ts",
    "#animations/*": "./src/animations/*"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IgniteUI/igniteui-webcomponents"
  },
  "bugs": {
    "url": "https://github.com/IgniteUI/igniteui-webcomponents/issues"
  },
  "scripts": {
    "start": "npm run storybook",
    "build:publish": "npm run cem && node scripts/build.mjs",
    "cem": "cem analyze --config cem.config.mjs",
    "cem:watch": "cem analyze --config cem.config.mjs --watch",
    "build:styles": "node scripts/build-styles.mjs",
    "build:meta": "node scripts/build-stories.mjs",
    "watch-meta": "node scripts/stories-watcher.mjs",
    "watch-scss": "node scripts/styles-watcher.mjs",
    "check-imports": "depcruise --config .dependency-cruiser.cjs --output-type err ./src/index.ts",
    "check-types": "tsc -p scripts/tsconfig-ci.json",
    "check-scripts": "tsc -p scripts/tsconfig.json",
    "check-stories": "tsc -p scripts/tsconfig.stories.json",
    "check-aliases": "node scripts/check-import-aliases.mjs",
    "check": "concurrently -g \"npm:check-*\"",
    "clean": "rimraf ./dist ./docs --glob \"src/**/*.css.ts\"",
    "lint": "concurrently -g \"npm:lint:*\"",
    "lint:oxlint": "oxlint",
    "lint:lit-analyzer": "lit-analyzer",
    "lint:oxfmt": "oxfmt --check",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "format": "oxlint --fix && oxfmt",
    "release": "node scripts/gen-changelog.mjs",
    "test": "npm run build:styles && wtr --coverage",
    "test:watch": "npm run build:styles && concurrently -k -r \"npm:watch-scss\" \"wtr --watch\"",
    "storybook": "npm run build:styles && concurrently -k -r \"npm run cem:watch\" \"npm:watch-scss\" \"npm:watch-meta\" \"storybook dev -p 8000\"",
    "storybook:build": "npm run build:styles && storybook build -o ./storybook-static",
    "build:typedoc:export": "node scripts/build-typedoc.mjs export",
    "build:typedoc:import": "node scripts/build-typedoc.mjs import",
    "build:typedoc:watch": "node scripts/build-typedoc.mjs watch",
    "build:typedoc:serve": "node scripts/build-typedoc.mjs serve",
    "build:typedoc:ja": "node scripts/build-typedoc.mjs buildJA",
    "build:typedoc:en": "node scripts/build-typedoc.mjs buildEN",
    "prepare": "husky"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@lit/context": "^1.1.6",
    "igniteui-i18n-core": "^1.0.5",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@igniteui/material-icons-extended": "^3.1.0",
    "@open-wc/testing": "^5.0.0",
    "@storybook/addon-a11y": "^10.5.9",
    "@storybook/addon-docs": "^10.5.9",
    "@storybook/addon-links": "^10.5.9",
    "@storybook/web-components-vite": "^10.5.9",
    "@types/mocha": "^10.0.10",
    "@web/dev-server-esbuild": "^2.0.0",
    "@web/test-runner": "^1.0.0",
    "@web/test-runner-playwright": "^1.0.0",
    "autoprefixer": "^10.5.4",
    "cem-plugin-expanded-types": "^1.4.0",
    "concurrently": "^10.0.5",
    "custom-element-jet-brains-integration": "^1.7.0",
    "custom-element-vs-code-integration": "^1.5.0",
    "custom-elements-manifest": "^2.1.0",
    "dependency-cruiser": "^18.2.0",
    "husky": "^9.1.7",
    "ig-typedoc-theme": "^7.0.1",
    "igniteui-i18n-resources": "^1.0.5",
    "igniteui-theming": "^28.0.0-beta.4",
    "keep-a-changelog": "^3.1.0",
    "lint-staged": "^17.3.0",
    "lit-analyzer": "^2.0.3",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "rimraf": "^6.1.3",
    "sass-embedded": "~1.93.3",
    "sinon": "^22.1.0",
    "storybook": "^10.5.9",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.2.0",
    "ts-lit-plugin": "^2.0.2",
    "tslib": "^2.8.1",
    "typedoc": "~0.28.20",
    "typedoc-plugin-localization": "^3.1.0",
    "typescript": "^6.0.3",
    "vite": "~8.2.1"
  },
  "peerDependencies": {
    "dompurify": "^3.4.13",
    "marked": "^18.0.10",
    "marked-shiki": "^1.2.1",
    "shiki": "^4.4.3"
  },
  "browserslist": [
    "defaults"
  ],
  "lint-staged": {
    "*.{js,ts,cjs,mjs,jsx,tsx}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt"
    ]
  },
  "customElements": "custom-elements.json"
}
