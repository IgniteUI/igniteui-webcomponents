{
  "name": "igniteui-webcomponents",
  "version": "0.0.0",
  "description": "Ignite UI Web Components",
  "author": "Infragistics",
  "license": "MIT",
  "exports": {
    ".": "./src/index.js",
    "./types": "./src/types.js",
    "./extras": "./src/extras/index.js",
    "./extras/combo-data-source": "./src/extras/combo-data-source.js"
  },
  "imports": {
    "#internals/*.js": "./src/internals/*.ts",
    "#internals/*": "./src/internals/*",
    "#theming/*.js": "./src/theming/*.ts",
    "#theming/*": "./src/theming/*",
    "#themes/*.js": "./src/components/*.ts",
    "#animations/*.js": "./src/animations/*.ts",
    "#animations/*": "./src/animations/*"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IgniteUI/igniteui-webcomponents"
  },
  "bugs": {
    "url": "https://github.com/IgniteUI/igniteui-webcomponents/issues"
  },
  "scripts": {
    "start": "npm run storybook",
    "build:publish": "npm run cem && node scripts/build.mjs",
    "build:sbom": "node scripts/build-sbom.mjs",
    "cem": "cem analyze --config cem.config.mjs",
    "cem:watch": "cem analyze --config cem.config.mjs --watch",
    "public-api:update": "npm run cem && node scripts/public-api.mjs --update && node scripts/api-reference.mjs --update",
    "build:styles": "node scripts/build-styles.mjs",
    "build:meta": "node scripts/build-stories.mjs",
    "watch-meta": "node scripts/stories-watcher.mjs",
    "watch-scss": "node scripts/styles-watcher.mjs",
    "check-imports": "depcruise --config .dependency-cruiser.cjs --output-type err ./src/index.ts",
    "check-types": "tsc -p scripts/tsconfig-ci.json",
    "check-scripts": "tsc -p scripts/tsconfig.json",
    "check-stories": "tsc -p scripts/tsconfig.stories.json",
    "check-aliases": "node scripts/check-import-aliases.mjs",
    "check-registration": "node scripts/check-registration.mjs",
    "check-public-api": "cem analyze --config cem.config.mjs --quiet && node scripts/public-api.mjs && node scripts/api-reference.mjs",
    "check": "concurrently -g \"npm:check-*\"",
    "report:spec-scenarios": "node scripts/check-spec-scenarios.mjs",
    "clean": "rimraf ./dist ./docs --glob \"src/**/*.css.ts\"",
    "lint": "concurrently -g \"npm:lint:*\"",
    "lint:oxlint": "oxlint",
    "lint:lit-analyzer": "lit-analyzer",
    "lint:oxfmt": "oxfmt --check",
    "lint:styles": "stylelint \"src/**/*.scss\" --cache --cache-strategy content --cache-location node_modules/.cache/stylelint/",
    "format": "oxlint --fix && oxfmt",
    "release": "node scripts/gen-changelog.mjs",
    "test": "npm run build:styles && wtr --coverage",
    "test:ssr": "npm run build:publish && node scripts/ssr-smoke.mjs",
    "test:migrations": "node --test tests/migrations/*.mjs",
    "test:watch": "npm run build:styles && concurrently -k -r \"npm:watch-scss\" \"wtr --watch\"",
    "storybook": "npm run build:styles && concurrently -k -r \"npm run cem:watch\" \"npm:watch-scss\" \"npm:watch-meta\" \"storybook dev -p 8000\"",
    "storybook:build": "npm run build:styles && storybook build -o ./storybook-static",
    "build:typedoc:export": "node scripts/build-typedoc.mjs export",
    "build:typedoc:import": "node scripts/build-typedoc.mjs import",
    "build:typedoc:watch": "node scripts/build-typedoc.mjs watch",
    "build:typedoc:serve": "node scripts/build-typedoc.mjs serve",
    "build:typedoc:ja": "node scripts/build-typedoc.mjs buildJA",
    "build:typedoc:en": "node scripts/build-typedoc.mjs buildEN",
    "prepare": "husky"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.8.0",
    "@lit/context": "^1.1.6",
    "igniteui-i18n-core": "^2.0.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@cyclonedx/cyclonedx-npm": "^7.0.1",
    "@igniteui/material-icons-extended": "^3.1.0",
    "@lit-labs/ssr": "^4.1.0",
    "@open-wc/testing": "^5.0.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-links": "^10.6.7",
    "@storybook/web-components-vite": "^10.6.7",
    "@stylistic/stylelint-plugin": "^6.0.1",
    "@types/mocha": "^10.0.10",
    "@wc-toolkit/type-parser": "~1.3.1",
    "@web/dev-server-esbuild": "^2.0.1",
    "@web/test-runner": "^1.0.1",
    "@web/test-runner-playwright": "^1.0.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "ajv-formats-draft2019": "^1.6.1",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "custom-element-jet-brains-integration": "^1.8.0",
    "custom-element-vs-code-integration": "^1.5.0",
    "custom-elements-manifest": "^2.1.0",
    "dependency-cruiser": "^18.7.2",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "ig-typedoc-theme": "^7.0.1",
    "igniteui-i18n-resources": "^2.0.0",
    "igniteui-theming": "^30.2.0",
    "keep-a-changelog": "^3.2.0",
    "lint-staged": "^17.6.1",
    "lit-analyzer": "^2.0.3",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "playwright": "^1.65.1",
    "postcss": "^8.5.33",
    "rimraf": "^6.1.4",
    "sass-embedded": "~1.108.2",
    "sinon": "^22.1.0",
    "storybook": "^10.6.7",
    "stylelint": "~18.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "stylelint-scss": "^7.5.0",
    "ts-lit-plugin": "^2.0.2",
    "tslib": "^2.9.1",
    "typedoc": "~0.28.20",
    "typedoc-plugin-localization": "^3.1.0",
    "typescript": "^6.0.3",
    "vite": "~8.3.8",
    "zxing-wasm": "^3.1.7"
  },
  "peerDependencies": {
    "dompurify": "^3.4.18",
    "marked": "^18.2.0",
    "shiki": "^4.6.0"
  },
  "browserslist": [
    "last 2 Chrome major versions",
    "last 2 Edge major versions",
    "last 2 Firefox major versions",
    "last 2 Opera major versions",
    "last 2 Safari major versions",
    "last 2 iOS major versions"
  ],
  "lint-staged": {
    "*.{js,ts,cjs,mjs,jsx,tsx}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt"
    ]
  },
  "customElements": "custom-elements.json"
}
