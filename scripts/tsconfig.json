{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ESNext"],
    "types": ["node"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "custom-elements-manifest/schema": [
        "../node_modules/custom-elements-manifest/schema.d.ts"
      ]
    }
  },
  "include": ["**/*.mjs"]
}
